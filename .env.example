# Exemple de fichier .env - À copier vers .env pour l'utilisation
# Variables d'environnement pour l'outil de triangulation SDR

# Configuration générale
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Configuration du serveur web
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
SECRET_KEY=change_this_to_a_secure_random_value_in_production

# Configuration des bases de données (si nécessaire)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sdr_triangulation
# DB_USER=postgres
# DB_PASSWORD=password

# Chemins des fichiers
EXPORT_PATH=./exports
LOG_FILE=./logs/app.log
CONFIG_FILE=./config/default_config.yaml 
# Configuration pour l'outil de triangulation SDR en local

# Configuration générale
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Configuration du serveur web
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
SECRET_KEY=local_dev_secret_key_not_for_production

# Configuration des bases de données (si nécessaire)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sdr_triangulation
# DB_USER=postgres
# DB_PASSWORD=password

# Chemins des fichiers
EXPORT_PATH=./exports
LOG_FILE=./logs/app.log
CONFIG_FILE=./config/default_config.yaml 